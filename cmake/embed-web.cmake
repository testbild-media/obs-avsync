# Converts all files in INPUT_DIR into a C++ source with byte arrays (findEmbeddedFile()).
# Usage: cmake -DINPUT_DIR=<dir> -DOUTPUT=<file.cpp> -P embed-web.cmake

file(GLOB files RELATIVE "${INPUT_DIR}" "${INPUT_DIR}/*")
list(SORT files)

set(body "")
set(table "")
set(index 0)
foreach(f IN LISTS files)
  if(IS_DIRECTORY "${INPUT_DIR}/${f}")
    continue()
  endif()
  get_filename_component(ext "${f}" LAST_EXT)
  string(TOLOWER "${ext}" ext)
  if(ext STREQUAL ".html")
    set(mime "text/html; charset=utf-8")
  elseif(ext STREQUAL ".js")
    set(mime "text/javascript; charset=utf-8")
  elseif(ext STREQUAL ".css")
    set(mime "text/css; charset=utf-8")
  elseif(ext STREQUAL ".svg")
    set(mime "image/svg+xml")
  elseif(ext STREQUAL ".png")
    set(mime "image/png")
  elseif(ext STREQUAL ".mp4")
    set(mime "video/mp4")
  elseif(ext STREQUAL ".webmanifest")
    set(mime "application/manifest+json")
  elseif(ext STREQUAL ".json")
    set(mime "application/json")
  else()
    continue()
  endif()

  file(READ "${INPUT_DIR}/${f}" hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR size "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," arr "${hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n" arr "${arr}")
  string(APPEND body "const unsigned char kFile${index}[] = {\n${arr}0x00};\n\n")
  string(APPEND table "\t{\"/${f}\", \"${mime}\", kFile${index}, ${size}},\n")
  math(EXPR index "${index} + 1")
endforeach()

set(out "// Generated by cmake/embed-web.cmake - do not edit.\n#include \"web-server.hpp\"\n\nnamespace avs {\nnamespace {\n\n")
string(APPEND out "${body}")
string(APPEND out "const EmbeddedFile kFiles[] = {\n${table}};\n\n} // namespace\n\n")
string(APPEND out "const EmbeddedFile *findEmbeddedFile(const std::string &path)\n{\n\tfor (const auto &f : kFiles)\n\t\tif (path == f.path)\n\t\t\treturn &f;\n\treturn nullptr;\n}\n\n} // namespace avs\n")

# only touch the output when the content changed (avoids needless rebuilds)
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
  if(old STREQUAL out)
    return()
  endif()
endif()
file(WRITE "${OUTPUT}" "${out}")
